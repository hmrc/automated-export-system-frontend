# microservice specific routes

->          /hmrc-frontend                               hmrcfrontend.Routes

GET         /assets/*file                                controllers.Assets.versioned(path="/public", file: Asset)

GET         /                                            uk.gov.hmrc.automatedexportsystemfrontend.controllers.IndexController.onPageLoad()

GET         /language/:lang                              uk.gov.hmrc.automatedexportsystemfrontend.controllers.LanguageSwitchController.switchToLanguage(lang: String)

GET         /refresh-session                             uk.gov.hmrc.automatedexportsystemfrontend.controllers.KeepAliveController.keepAlive()

GET         /there-is-a-problem                          uk.gov.hmrc.automatedexportsystemfrontend.controllers.problem.JourneyRecoveryController.onPageLoad(continueUrl: Option[RedirectUrl] ?= None)

