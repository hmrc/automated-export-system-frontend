# microservice specific routes

->          /hmrc-frontend                               hmrcfrontend.Routes

GET         /                                            controllers.IndexController.onPageLoad()

GET         /assets/*file                                controllers.Assets.versioned(path="/public", file: Asset)

GET         /language/:lang                              controllers.LanguageSwitchController.switchToLanguage(lang: String)

GET         /refresh-session                             controllers.KeepAliveController.keepAlive()

GET         /there-is-a-problem                          controllers.problem.JourneyRecoveryController.onPageLoad(continueUrl: Option[RedirectUrl] ?= None)

GET         /check-your-answers                          controllers.CheckYourAnswersController.onPageLoad()

GET         /account/sign-out-survey                     controllers.auth.AuthController.signOut()
GET         /account/sign-out                            controllers.auth.AuthController.signOutNoSurvey()
GET         /account/signed-out                          controllers.auth.SignedOutController.onPageLoad()

GET         /unauthorised                                controllers.UnauthorisedController.onPageLoad()

GET        /mrn                        controllers.happyPath.EnterMrnController.onPageLoad(mode: Mode = NormalMode)
POST       /mrn                        controllers.happyPath.EnterMrnController.onSubmit(mode: Mode = NormalMode)
GET        /changeMrn                  controllers.happyPath.EnterMrnController.onPageLoad(mode: Mode = CheckMode)
POST       /changeMrn                  controllers.happyPath.EnterMrnController.onSubmit(mode: Mode = CheckMode)

GET        /ducr                        controllers.happyPath.EnterDucrController.onPageLoad(mode: Mode = NormalMode)
POST       /ducr                        controllers.happyPath.EnterDucrController.onSubmit(mode: Mode = NormalMode)
GET        /changeDucr                  controllers.happyPath.EnterDucrController.onPageLoad(mode: Mode = CheckMode)
POST       /changeDucr                  controllers.happyPath.EnterDucrController.onSubmit(mode: Mode = CheckMode)

GET        /part-of-consolidation                        controllers.happyPath.PartOfConsolidationController.onPageLoad(mode: Mode = NormalMode)
POST       /part-of-consolidation                        controllers.happyPath.PartOfConsolidationController.onSubmit(mode: Mode = NormalMode)
GET        /change-part-of-consolidation                  controllers.happyPath.PartOfConsolidationController.onPageLoad(mode: Mode = CheckMode)
POST       /change-part-of-consolidation                  controllers.happyPath.PartOfConsolidationController.onSubmit(mode: Mode = CheckMode)

GET        /split-exit                        controllers.happyPath.IsSplitExitController.onPageLoad(mode: Mode = NormalMode)
POST       /split-exit                        controllers.happyPath.IsSplitExitController.onSubmit(mode: Mode = NormalMode)
GET        /change-split-exit                  controllers.happyPath.IsSplitExitController.onPageLoad(mode: Mode = CheckMode)
POST       /change-split-exit                  controllers.happyPath.IsSplitExitController.onSubmit(mode: Mode = CheckMode)

GET        /anyDiscrepancies                        controllers.happyPath.AnyDiscrepanciesController.onPageLoad(mode: Mode = NormalMode)
POST       /anyDiscrepancies                        controllers.happyPath.AnyDiscrepanciesController.onSubmit(mode: Mode = NormalMode)
GET        /changeAnyDiscrepancies                  controllers.happyPath.AnyDiscrepanciesController.onPageLoad(mode: Mode = CheckMode)
POST       /changeAnyDiscrepancies                  controllers.happyPath.AnyDiscrepanciesController.onSubmit(mode: Mode = CheckMode)

GET        /check-answers                       controllers.CYASubmissionController.onPageLoad()
