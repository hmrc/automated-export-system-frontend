POST       /mrn                        uk.gov.hmrc.automatedexportsystemfrontend.controllers.happyPath.EnterMrnController.onSubmit(mode: uk.gov.hmrc.automatedexportsystemfrontend.models.Mode = uk.gov.hmrc.automatedexportsystemfrontend.models.NormalMode)
